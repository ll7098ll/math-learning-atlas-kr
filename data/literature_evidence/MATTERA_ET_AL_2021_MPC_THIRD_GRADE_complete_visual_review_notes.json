    "bibliography_snapshot": "3cbde38f9410033f3af4b9923b5e7e665c9861ccdbda7266fbb7d0ee67405282",
    "display": {
      "title": "Long-Term Effects of Enhanced Early Childhood Math Instruction: The Impacts of Making Pre-K Count and High 5s on Third-Grade Outcomes",
      "url": "https://www.mdrc.org/work/publications/long-term-effects-enhanced-early-childhood-math-instruction",
      "authors_year": "Mattera 외, 2021"
    },
    "read_scope": "기관·아동 배정도, 분석 표본, 탈락 설명, 3학년 수학 결과와 상충하는 표 주석을 지정 PDF 9쪽과 판면 5쪽에서 대조했다. 부록 B·F의 분석 모형과 탐색 표를 PDF 65~68·93~95쪽에서 확인했다. WWC 90485의 2026년 심사 3건과 후속 권호 논문에 표시된 3학년 수학 결과를 대조했다. 3학년 비교별 사전등록 계획 3편과 최종 보고서의 배정, 표본 분모, 기초 공변량 대치, 탐색 분석을 대조했다. WWC 기준 4.1에서 결측 처리 방법과 추적 탈락 수준의 검토 단계를 확인했다.",
    "scope_note": "해당 영역에서 실제 제공한 지도 조건과 결과를 연결한다.",
    "method_note": "출판판의 방법·표·그림과 대상 성취기준의 수행 범위를 대조했다.",
    "limits": "세 비교는 동일 분모가 아니며 추가와 결합 비교의 중재군은 겹친다. 학교에 남은 아동의 선택과 결과 미확보를 고려하며 국내 특정 초등 과제의 장기 효과로 해석하지 않는다.",
    "empirical_scope": {
      "design": "취학 전 기관 무작위 배정과 공립학교 잔류 아동의 유치원 개별 배정을 사용한 추적. 결과는 3학년 행정 자료.",
      "sample_description": "수학 점수가 있는 표본은 MPC 대 정규 945·899명, High 5s 추가 226·230명, 두 해 결합 대 정규 226·255명.",
      "inference_limit": "세 비교는 동일 분모가 아니며 추가와 결합 비교의 중재군은 겹친다. 학교에 남은 아동의 선택과 결과 미확보를 고려하며 국내 특정 초등 과제의 장기 효과로 해석하지 않는다.",
      "student_outcome_study": true,
      "causal_effect_established": false,
      "local_effect_tested": false,
      "study_family": "MDRC_MAKING_PRE_K_COUNT_HIGH_5S"
    },
    "independent_review": false,
    "student_validated": false,
    "editorial_action": "사전등록과 최종 보고서 대조의 근거 4건 및 자체 관찰 과제 4개를 추가했다.",
    "observations": [
      {
        "id": "MPC21-P1",
        "standard_codes": [
          "12실통02-02"
        ],
        "question": "가상 학교의 2013년 3학년 평균은 70점, 2019년 3학년 평균은 76점이다. 같은 학생이 6점 올랐는지 답하고, 개인의 변화를 보려면 어떤 자료가 필요한지 설명하라.",
        "expected": "두 시점의 학교 평균 차이는 6점이다. 같은 학생의 변화인지 확인하려면 같은 학생에게서 비교 가능한 시점별 점수와 검사 조건을 확보해야 한다.",
        "interpretation": "수집 단위가 학교인지 학생인지, 학생이 시점별로 연결되는지, 검사가 비교 가능한지를 기록한다.",
        "student_validated": false
      },
      {
        "id": "MPC21-P2",
        "standard_codes": [
          "12실통03-04"
        ],
        "question": "가상 분석 A의 p값은 0.19, 분석 B는 0.18이다. 유의수준 5%의 판정을 설명하라. 별도 검토표에 결측 처리 기준 미충족과 결과 미제공이 표시됐을 때 그 칸에 0을 넣어도 되는가?",
        "expected": "두 p값 모두 0.05보다 크므로 귀무가설을 기각하지 않는다. 결측 처리 판정은 분석 방법에 대한 평가다. 검토표에 결과 수치가 제공되지 않았으므로 효과 0이나 p값 0을 입력할 근거가 없다.",
        "interpretation": "통계 판정과 자료의 부재, 심사 판정의 차이를 구별한다.",
        "student_validated": false
      },
      {
        "id": "MPC21-P3",
        "standard_codes": [
          "12실통02-02"
        ],
        "question": "가상 연구의 학급 명단은 200명이고, 동의와 연령 조건을 충족한 사람은 180명이다. 결과가 하나라도 있는 사람은 160명, 수학 점수가 있는 사람은 135명이다. 적격자 기준 수학 점수 미확보 비율을 구하고 전체 명단 기준과 비교하라.",
        "expected": "적격자 기준은 (180−135)/180=25%다. 명단 전체 기준은 (200−135)/200=32.5%이며 적격자 외 학생도 포함한다. 160명은 수학 점수 확인 인원이 아니다.",
        "interpretation": "적격, 한 가지 이상 결과, 특정 결과의 분모와 분자를 구별한다.",
        "student_validated": false
      },
      {
        "id": "MPC21-P4",
        "standard_codes": [
          "12실통02-02"
        ],
        "question": "가상 연구에서 기관을 먼저 배정하고, 실험 기관에 남은 아동을 추가 활동 제공 여부로 다시 배정했다. 추가 활동 대 기본 프로그램 비교와 결합 프로그램 대 기존 교육 비교의 배정 단위를 구별하라.",
        "expected": "추가 활동은 같은 기관의 아동별 배정을 사용한다. 결합 비교는 기관별 최초 배정도 반영해야 한다. 추가 활동 집단은 두 비교에 공통으로 들어간다.",
        "interpretation": "첫 배정과 두 번째 배정, 잔류 조건과 집단 중복을 확인한다.",
        "student_validated": false
      },
      {
        "id": "MPC21-P5",
        "standard_codes": [
          "12실통02-02",
          "12실통03-04"
        ],
        "question": "가상 추적 자료에서 가 학생은 시작 때의 언어 점수만 없고 나 학생은 종료 수학 점수만 없다. 연구팀이 시작 점수 결측만 대치했다. 어떤 값이 아직 없으며 최종 심사를 판단하려면 무엇을 더 확인해야 하는가?",
        "expected": "나 학생의 종료 수학 점수는 여전히 없다. 대치 대상, 대치 절차와 표준오차 산출, 종료 자료 미확보의 분모와 집단 차이를 각각 확인해야 한다.",
        "interpretation": "기초 공변량과 결과의 시점 및 역할을 구별한다. 탈락률만으로 대치 방법 적합성을 판정하는지도 관찰한다.",
        "student_validated": false
      },
      {
        "id": "MPC21-P6",
        "standard_codes": [
          "12실통03-04"
        ],
        "question": "가상 연구에서 사전 지정한 주 분석의 p값은 .18, 같은 연구의 하위표본 탐색 분석은 .03이다. 각 분석에서 5% 기준을 적용한 결과와 보고할 때의 순서를 설명하라.",
        "expected": "주 분석에서는 기각하지 않고 탐색 분석은 해당 비교에서 기각한다. 사전 지정한 주 분석을 먼저 보고하고 같은 연구의 탐색 결과로 따로 표시한다.",
        "interpretation": "비교별 판정과 확인적·탐색적 역할을 따로 기록하며, 표본이 겹치는 두 분석을 독립 증거로 세는지 확인한다.",
        "student_validated": false
      }
